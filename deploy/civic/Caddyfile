{
	admin off
	servers {
		protocols h1 h2
	}
}

civic.lwdgyasteri.com {
	encode zstd gzip
	header -Server
	request_body {
		max_size 16KB
	}
	reverse_proxy app:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			dial_timeout 5s
			response_header_timeout 95s
		}
	}
}

(personal_portfolio_proxy) {
	reverse_proxy app:8000 {
		header_up Host civic.lwdgyasteri.com
		header_up X-Forwarded-Host civic.lwdgyasteri.com
		header_up X-Forwarded-Proto {scheme}
		transport http {
			dial_timeout 5s
			response_header_timeout 95s
		}
	}
}

derrickparker.lwdgyasteri.com {
	encode zstd gzip
	header -Server
	request_body {
		max_size 16KB
	}
	handle / {
		rewrite * /portfolio
		import personal_portfolio_proxy
	}
	@portfolio path /portfolio /portfolio/* /static/portfolio.css
	handle @portfolio {
		uri strip_suffix /
		import personal_portfolio_proxy
	}
	handle {
		redir https://civic.lwdgyasteri.com{uri} 302
	}
}
