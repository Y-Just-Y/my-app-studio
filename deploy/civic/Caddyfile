{
	admin off
	servers {
		protocols h1 h2
	}
}

civic.lwdgyasteri.com {
	encode zstd gzip
	header -Server
	request_body {
		max_size 16KB
	}
	reverse_proxy app:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			dial_timeout 5s
			response_header_timeout 95s
		}
	}
}
